<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="end|bottom"
        android:maxLines="1"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="64sp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:cursorVisible="false"
        android:inputType="none" />

    <!-- Row 1: C, ±, %, ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClear"
            style="@style/CalcButton.Function"
            android:text="C" />
        <Button
            android:id="@+id/btnToggleSign"
            style="@style/CalcButton.Function"
            android:text="±" />
        <Button
            android:id="@+id/btnPercent"
            style="@style/CalcButton.Function"
            android:text="%" />
        <Button
            android:id="@+id/btnDiv"
            style="@style/CalcButton.Operation"
            android:text="÷" />
    </LinearLayout>

    <!-- Row 2: 7, 8, 9, × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn7"
            style="@style/CalcButton.Digit"
            android:text="7" />
        <Button
            android:id="@+id/btn8"
            style="@style/CalcButton.Digit"
            android:text="8" />
        <Button
            android:id="@+id/btn9"
            style="@style/CalcButton.Digit"
            android:text="9" />
        <Button
            android:id="@+id/btnMul"
            style="@style/CalcButton.Operation"
            android:text="×" />
    </LinearLayout>

    <!-- Row 3: 4, 5, 6, − -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn4"
            style="@style/CalcButton.Digit"
            android:text="4" />
        <Button
            android:id="@+id/btn5"
            style="@style/CalcButton.Digit"
            android:text="5" />
        <Button
            android:id="@+id/btn6"
            style="@style/CalcButton.Digit"
            android:text="6" />
        <Button
            android:id="@+id/btnSub"
            style="@style/CalcButton.Operation"
            android:text="−" />
    </LinearLayout>

    <!-- Row 4: 1, 2, 3, + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn1"
            style="@style/CalcButton.Digit"
            android:text="1" />
        <Button
            android:id="@+id/btn2"
            style="@style/CalcButton.Digit"
            android:text="2" />
        <Button
            android:id="@+id/btn3"
            style="@style/CalcButton.Digit"
            android:text="3" />
        <Button
            android:id="@+id/btnAdd"
            style="@style/CalcButton.Operation"
            android:text="+" />
    </LinearLayout>

    <!-- Row 5: ⌫, 0, ., = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBackspace"
            style="@style/CalcButton.Function"
            android:text="⌫" />
        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton.Digit"
            android:text="0" />
        <Button
            android:id="@+id/btnDot"
            style="@style/CalcButton.Digit"
            android:text="." />
        <Button
            android:id="@+id/btnEquals"
            style="@style/CalcButton.Operation"
            android:text="=" />
    </LinearLayout>

</LinearLayout>
